    RETURN (274) 32
    IF (275) 35
    ELSE (276) 34
    WHILE (277) 36
    READ (278) 37
    WRITE (279) 38
    BOOLEAN_LITERAL (280) 50
    SHIFT_LEFT (281) 38
    SHIFT_RIGHT (282) 37


